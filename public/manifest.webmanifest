{
  "name": "ReadMe",
  "short_name": "ReadMe",
  "description": "Read and edit Markdown documents offline.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f8f8fb",
  "theme_color": "#6d28d9",
  "icons": [{ "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "text/markdown": [".md", ".markdown"],
        "text/plain": [".txt"]
      },
      "icons": [{ "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }],
      "launch_type": "single-client"
    }
  ],
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "files", "accept": ["text/markdown", "text/plain", ".md", ".markdown", ".txt"] }]
    }
  }
}
